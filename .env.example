# Optional: Pexels API (primary stock footage)
PEXELS_API_KEY=your_pexels_api_key_here

# Optional: GIPHY API (b-roll fallback)
GIPHY_API_KEY=your_giphy_api_key_here

# Optional: Pixabay API (b-roll fallback)
PIXABAY_API_KEY=your_pixabay_api_key_here

# Optional: ElevenLabs (voiceover fallback)
ELEVENLABS_API_KEY=your_elevenlabs_api_key_here
ELEVENLABS_VOICE_ID=21m00Tcm4TlvDq8ikWAM

# Optional: Hugging Face (thumbnail generation)
HF_API_TOKEN=your_hf_token_here

# Required: Telegram bot (approval workflow)
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here
